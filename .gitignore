node_modules/
**/dist/
**/*.tsbuildinfo
.env
.env.local
# Local compose overrides (e.g. SELF_HOSTED=false to rehearse the hosted
# entitlement ladder). The published default must stay self-host-friendly.
docker-compose.override.yml
coverage/
*.log
.DS_Store
plans/
# Anchored to the repo root. Unanchored, this also swallowed
# `core/src/migrate/`, the legacy importer, so a commit that added it pushed
# only the export lines and broke the build on main. The rule was always meant
# for the root-level scratch directory the legacy migration used.
/migrate/
.claude/
