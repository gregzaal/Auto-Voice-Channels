# Auto-Voice-Channels — example configuration.
# Copy to `.env` and fill in. Never commit a real `.env` (secrets!).
# Config is zod-validated at startup; the process fails fast on bad/missing values.

# --- Required ---
# Discord bot token (Developer Portal > Bot). Keep secret.
DISCORD_TOKEN=
# Discord application (client) id, used for slash-command registration.
CLIENT_ID=
# Optional: a dev/test server id. When set, slash commands register to just that
# guild and appear INSTANTLY (global registration can take up to ~1 hour). Get the
# id via Discord → Settings → Advanced → Developer Mode, then right-click the
# server → Copy Server ID. Leave blank in production.
# DEV_GUILD_ID=
# Postgres connection string (source of truth).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/avc

# --- Self-hosting ---
# Self-hosting is the default: the entitlement gate always allows, so there is
# no trial, billing, or paywall to worry about. You do not need to set this.
# (Only the official hosted service runs with SELF_HOSTED=false.)
# SELF_HOSTED=true

# Which hosted fleet this process is. Self-hosters can ignore this entirely: you
# are the only fleet in your own database, so it defaults to "prod" and the
# scoping it controls is a no-op. It exists because the hosted service runs two
# live bots (production and an opt-in beta) against one database, and each needs
# its own shard leases, identify buckets and runtime flags.
# FLEET=prod

# --- Sharding / instance ---
# Total shard count across all instances (managed value). 1 is fine for self-host.
TOTAL_SHARDS=1
# Fleet size: each instance claims free shards up to ceil(TOTAL_SHARDS /
# EXPECTED_INSTANCES), so shards spread across the fleet. Keep in sync with the
# running machine count. 1 (self-host) → this instance claims every shard.
EXPECTED_INSTANCES=1
# Stable id for this running instance (used for shard leases).
INSTANCE_ID=local

# --- AI-assisted templates (optional) ---
# `/templateassistant` lets admins describe the channel names they want in plain
# language and writes the template for them. It is OFF unless you set a key, and
# the command isn't even registered until you do.
#
# Any OpenAI-compatible /v1/chat/completions endpoint works, so one set of vars
# covers OpenAI, OpenRouter (hundreds of models, switch by changing the model
# name), Groq / Together / Fireworks, or a local Ollama / LM Studio / vLLM.
#   OpenAI       https://api.openai.com/v1        (the default)
#   OpenRouter   https://openrouter.ai/api/v1
#   Ollama       http://localhost:11434/v1        (any key value; it ignores it)
# AVC_AI_API_KEY=
# AVC_AI_BASE_URL=https://api.openai.com/v1
# AVC_AI_MODEL=gpt-5.4-mini
# AVC_AI_TIMEOUT_MS=30000
# Only used to estimate spend for the hosted service's fleet-wide ceiling. Set
# both to 0 for a local model. Self-hosting ignores the ceiling entirely.
# AVC_AI_PRICE_INPUT_PER_MTOK=0.75
# AVC_AI_PRICE_OUTPUT_PER_MTOK=4.50

# --- Data backups (optional; set all five S3 vars to enable) ---
# Scheduled pg_dump to any S3-compatible bucket, taken in-process by the bot, so
# there is nothing else to run. Off unless configured. Setting only some of these
# is a startup error rather than a silent disable: a typo'd endpoint that quietly
# turned backups off would only be discovered during a restore.
# Works with Backblaze B2, Cloudflare R2, AWS S3 or MinIO.
# BACKUP_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
# BACKUP_S3_REGION=us-west-002
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Client-side AES-256-GCM, so the storage provider cannot read your guild and
# billing data. 32 bytes, base64 or hex: `openssl rand -base64 32`.
# STRONGLY recommended, and LOSING IT LOSES THE BACKUPS. Escrow it somewhere
# other than the machine it protects.
# BACKUP_ENCRYPTION_KEY=
# Optional tuning (defaults shown). Retention is grandfather-father-son: the
# newest backup is never pruned, whatever these are set to.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_PREFERRED_HOUR_UTC=3
# BACKUP_RETENTION_DAILY=7
# BACKUP_RETENTION_WEEKLY=4
# BACKUP_RETENTION_MONTHLY=6
# Object-key namespace, so one bucket can hold unrelated backup sets.
# BACKUP_PREFIX=
# Restore drill. Weekly by default: the newest backup is re-downloaded,
# checksummed against its manifest, decrypted with the key set above, and handed
# to pg_restore to confirm the archive still parses and still contains your
# tables. This is the check that notices a bucket quietly rotting, an encryption
# key that no longer matches, or a lifecycle rule deleting objects. Failures go
# to ADMIN_CHANNEL_ID.
# BACKUP_DRILL_INTERVAL_HOURS=168
# Optional, and off by default. Point this at a SEPARATE, EMPTY database and the
# drill also restores the dump into it and compares row counts, then wipes it
# again. Never point it at the database you are backing up: the drill checks
# that you have not and refuses, but the restore is destructive to whatever is
# in there.
# BACKUP_DRILL_DATABASE_URL=

# --- Ops ---
# HTTP port for the health (/health) and diagnostics (/diagnostics) endpoints.
HTTP_PORT=8080
# How the bot tells you something went wrong. Set this to a text channel id and it
# posts significant errors there: gateway failures, commands that could not finish,
# and anything else it could not handle on its own. Leave it unset (the default)
# and those only ever reach this container's logs, which for most self-hosts means
# nobody ever sees them. Worth setting even on a small instance.
# Not a DM: a bot cannot DM a user who has DMs closed, and a channel keeps history.
# ADMIN_CHANNEL_ID=
# Bearer token guarding GET /diagnostics, which exposes shard topology, every
# runtime flag and (where configured) estimated AI spend. Optional for a
# self-host: leave it unset and the endpoint is open, which is usually what you
# want on a box only you can reach. Set it and callers must send
# `Authorization: Bearer <token>`; anything else gets a 404. Minimum 16 chars,
# e.g. `openssl rand -hex 32`. The hosted service REQUIRES this.
# DIAGNOSTICS_TOKEN=
# Dead-man's switch. The bot POSTs this URL every minute while it is healthy,
# and whatever is on the other end tells you when the POSTs stop. That is the
# only way to find out your bot has died without watching it yourself: every
# other check here has to be asked, and a process that has crashed cannot answer.
# Any heartbeat service works, including free ones (UptimeRobot, healthchecks.io,
# Better Stack). Create a heartbeat or cron monitor, paste its URL here, and set
# the grace window to at least 5 minutes so a slow tick is not a false alarm.
# Unset (the default) means no ping and no change in behaviour.
# The bot deliberately stops pinging when it is running but not working, so a
# missed heartbeat means "look at this", not only "the process exited".
# WATCHDOG_PING_URL=
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# development | test | production
NODE_ENV=development
